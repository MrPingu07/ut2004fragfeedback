[Public]
Object=(Name=FragFeedback.FragFeedbackMutator,Class=Class,MetaClass=Engine.Mutator,Description="GTA V Frag Feedback,Kill feedback in GTA V style: when you frag someone, your screen flashes in your color (blue by default) - it quickly appears and slowly vanishes. Color and duration are configurable from the Mutators screen.")

[FragFeedback.FragFeedbackMutator]
FriendlyName="GTA V Frag Feedback"
Description="Kill feedback in GTA V style: whenever you frag someone, your screen flashes with a full-screen colored postprocess effect (blue by default) that quickly appears and slowly vanishes. Team kills stay silent. Color (RGB channels) and duration are configurable from the mutators screen [Configure Mutators button]."

; -- mutator GUI ([Configure Mutators] / PlayInfo) -----------------------------------
FlashGroup="Frag Feedback"
DurationDisplayText="Duration (seconds)"
DurationDescText="Total seconds the colored screen flash takes from its quick onset to fully gone, after each of your frags (minimum 0.1 seconds)."
ColorRDisplayText="Color R (0-1)"
ColorRDescText="Red channel of the flash. Default is 0.20 / 0.20 / 0.50 (cool cyan-blue); a red flash would be 0.9 / 0.05 / 0.05."
ColorGDisplayText="Color G (0-1)"
ColorGDescText="Green channel of the flash."
ColorBDisplayText="Color B (0-1)"
ColorBDescText="Blue channel of the flash."

; -- console feedback ----------------------------------------------------------------
MsgTestShown="FragFeedback: fake flash displayed."
